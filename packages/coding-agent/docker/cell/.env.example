# Supabase project with docker/cell/supabase/001_cell_api_keys.sql applied.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
# For a Supabase stack running on the Docker host:
# CELL_DOCKER_SUPABASE_URL=http://host.docker.internal:8000

# Independent webhook authentication and AES-256-GCM key encryption.
# Generate examples with: openssl rand -base64 32
CELL_WEBHOOK_SECRET=replace-with-a-separate-random-secret
CELL_KEY_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
CELL_KEY_ENCRYPTION_KEY_VERSION=1

# Replace these before exposing the stack beyond localhost. Keep the salt stable.
LITELLM_MASTER_KEY=sk-replace-with-a-long-random-master-key
LITELLM_SALT_KEY=sk-replace-with-a-long-random-salt-key

# Optional localhost ports. These avoid common Supabase local-stack ports.
CELL_LITELLM_PORT=14000
CELL_AUTH_BACKEND_PORT=14010

# Optional public URLs returned to CELL and extra managed MCP definitions.
CELL_LITELLM_PUBLIC_BASE_URL=http://127.0.0.1:14000/v1
# CELL_MCP_SERVERS_JSON=[{"name":"litellm-upload","url":"http://127.0.0.1:14000/upload_file/mcp"}]
